---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
const roles = [
  { years:'Present', title:'Research Scientist & AI/ML Engineer', org:'Rezolve AI', text:'Research and engineering for search, recommendation, conversational commerce, and agent evaluation.' },
  { years:'2020—Present', title:'PhD Candidate, Computer Science & Engineering', org:'Instituto Superior Técnico · INESC-ID · GAIPS', text:'Research on reinforcement learning, hierarchical structures, function approximation, and non-stationarity. Awaiting defense.' },
  { years:'Sep—Dec 2024', title:'Visiting Researcher', org:'Amii · University of Alberta', text:'Hosted by Marlos C. Machado. Worked with the wider Alberta reinforcement-learning community on structured exploration, options, eigenoptions, and Laplacian and successor representations.', material:'/materials/cover-time-options-one-dimensional-environments-note.pdf' },
  { years:'2021', title:'Machine Learning Scientist Intern', org:'Zebra Technologies', text:'Hierarchical and multi-agent reinforcement learning for warehouse environments.' },
  { years:'2020—2022', title:'Teaching Assistant', org:'Instituto Superior Técnico', text:'Planning, Learning and Decision Making.' },
  { years:'2020—2021', title:'Junior Researcher & Lab Manager', org:'GAIPS, INESC-ID', text:'Research in natural language processing; managed research infrastructure.' }
];
const conferenceReviewing = ['NeurIPS · 2022–2026','ICML · 2023–2024','ICLR · 2024','AAAI · 2025','AISTATS · 2026','ECAI · 2023','IROS · 2023','RLC workshops · 2025–2026'];
const journalReviewing = ['Transactions on Machine Learning Research (TMLR)','Neural Computing and Applications','Journal of Artificial Intelligence Research (JAIR)','Data Mining and Knowledge Discovery','Discover Artificial Intelligence','Autonomous Agents and Multi-Agent Systems'];
---
<BaseLayout title="Diogo S. Carvalho — Research Scientist & AI Engineer CV" description="Research, engineering, education, and academic service of Diogo S. Carvalho, specializing in reinforcement learning and reliable agentic systems.">
  <section class="page-hero cv-hero shell"><p class="eyebrow">Curriculum vitae</p><h1>Reinforcement learning foundations.<br/> <em>Reliable agentic systems.</em></h1><p>A research scientist and AI engineer working across reinforcement learning theory, multi-agent systems, and evaluated AI products.</p><a class="button primary" href="mailto:diogo.s.carvalho@tecnico.ulisboa.pt?subject=CV%20request">Request CV · Email ↗</a><small>The full CV is available by request; no private contact details are published here.</small></section>
  <section class="timeline shell section-space"><div class="timeline-title"><p class="eyebrow">Experience</p><h2>Work & research</h2></div><div>{roles.map(role => <article><time>{role.years}</time><div><h3>{role.title}</h3><strong>{role.org}</strong><p>{role.text}</p>{role.material && <a class="inline-link" href={role.material} target="_blank" rel="noreferrer">Joint research note ↗</a>}</div></article>)}</div></section>
  <section class="milestone shell section-space"><div><p class="eyebrow">PhD milestone</p><h2>Thesis proposal defended</h2><time datetime="2023-09-11">11 September 2023</time></div><div><p>I defended “Convergence and Performance Results for Reinforcement Learning with Two Time Scales” at Instituto Superior Técnico.</p><p>With thanks to committee members Gergely Neu, João Xavier, Pedro A. Santos, and Francisco S. Melo, and to the colleagues whose discussions helped shape the proposal.</p><div class="milestone-links"><a href="/materials/phd-thesis-proposal-document.pdf" target="_blank" rel="noreferrer">Proposal document ↗</a><a href="/materials/phd-thesis-proposal-slides.pdf" target="_blank" rel="noreferrer">Defence slides ↗</a></div></div></section>
  <section class="cv-grid shell section-space"><div><p class="eyebrow">Education</p><article><span>2020—Present</span><h3>PhD, Computer Science & Engineering</h3><p>Instituto Superior Técnico, Universidade de Lisboa · awaiting defense</p></article><article><span>2017—2019</span><h3>MSc, Applied Mathematics & Computation</h3><p>Instituto Superior Técnico, Universidade de Lisboa</p></article><article><span>2014—2017</span><h3>BSc, Applied Mathematics & Computation</h3><p>Instituto Superior Técnico, Universidade de Lisboa</p></article></div><div><p class="eyebrow">Recognition</p><article class="award-card"><span>2024</span><h3>Best Ph.D. Student Nomination</h3><p>Nomination for Best Ph.D. Student at INESC-ID.</p></article><article class="award-card"><span>2023</span><h3>Outstanding Paper Award</h3><p>26th European Conference on Artificial Intelligence, for “Theoretical Remarks on Feudal Hierarchies and Reinforcement Learning.”</p><a href="https://ecai2023.eu/bpa">Official record ↗</a></article></div></section>
  <section class="service shell section-space"><div class="section-heading"><div><p class="eyebrow">Academic citizenship</p><h2>Service</h2></div></div><div class="service-grid"><article><h3>Organization</h3><p><a href="https://www.ecai2024.eu/" target="_blank" rel="noreferrer">Workflow Manager · ECAI 2024 ↗</a></p><p><a href="https://cog2025.inesc-id.pt/" target="_blank" rel="noreferrer">Volunteer · IEEE CoG 2025 ↗</a></p></article><article><h3>Conference reviewing</h3><ul>{conferenceReviewing.map(item => <li>{item}</li>)}</ul></article><article><h3>Journal reviewing</h3><ul>{journalReviewing.map(item => <li>{item}</li>)}</ul></article></div><p class="confidentiality-note">Service records list venues and years only; confidential review details are never published.</p></section>
  <div class="shell section-space profiles-section"><ProfileLinks /></div>
</BaseLayout>
